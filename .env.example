# Discord Bot Token (From https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# The channel snowflake ID where the Roblox verification embed panel will be sent
VERIFICATION_CHANNEL_ID=1556000182196506684

# Roles for verification flow
VERIFIED_ROLE_ID=1556000033604640949
UNVERIFIED_ROLE_ID=1556000025216163961

# Roles automatically assigned to members when they join the server
JOIN_ROLE_1=1556000025216163961
JOIN_ROLE_2=1556000024712712272

# Automatically update Discord server nickname to Roblox username (true/false)
UPDATE_NICKNAME=true

# Groq AI API Key (From https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model
GROQ_MODEL=openai/gpt-oss-120b

# Role ID to ping when a ticket is escalated
ESCALATION_ROLE_ID=1556000020434526228

# Channel ID for escalated tickets log/summary
ESCALATED_TICKETS_CHANNEL_ID=1556004251241545961

# Channel ID for AI training messages and embeds (#ai-trainer)
AI_TRAINER_CHANNEL_ID=1556003671320559737

# Category ID where new ticket channels will be created
TICKETS_CATEGORY_ID=1556000041309708390

# Channel ID where ticket transcripts (HTML/Text) will be posted on close
TRANSCRIPT_CHANNEL_ID=1556000161690292274

# Optional: Server/Guild ID for instant slash command synchronization (0 for global)
GUILD_ID=0
